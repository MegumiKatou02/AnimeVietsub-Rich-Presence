{
    "manifest_version": 3,
    "name": "AnimeVietsub Presence Tracker",
    "version": "1.0",
    "description": "RPC cho website AnimeVietsub",
    "permissions": [
      "tabs",
      "scripting",
      "activeTab",
      "storage"
    ],
    "host_permissions": [
      "*://*.youtube.com/*",
      "*://animevietsub.lol/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
          "matches": ["*://animevietsub.lol/*"],
          "js": ["content/animevietsub.js"],
          "all_frames": true
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }
  